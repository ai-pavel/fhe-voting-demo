pragma solidity ^0.8.24;

import {FHE, ebool, externalEbool} from "@fhevm/solidity/lib/FHE.sol";
import {EncryptedTally} from "./EncryptedTally.sol";

/// @notice Groth16 verifier generated by gnark from the MPC ceremony (`npm run zk:setup`).
interface IVoteVerifier {
    /// @dev Reverts if the proof is invalid or an input is not a reduced BN254 field element.
    function verifyProof(bytes calldata proof, uint256[4] calldata input) external view;
}

/// @title Anonymous confidential yes/no vote
/// @notice Combines the three techniques of the demo:
///         - zkSNARK (gnark, Groth16): the voter proves they are in the registered voter list without revealing
///           which entry they are, so the contract never learns WHO voted;
///         - FHE (Zama FHEVM): the ballot is an encrypted `ebool`, so nobody learns HOW anyone voted, and only the
///           totals are decrypted after the deadline;
///         - MPC, twice: the Groth16 keys come from a multi-party trusted-setup ceremony (safe if ONE participant
///           was honest), and the FHE key is held by the Zama KMS as threshold shares.
/// @dev Ballots are meant to be submitted by a relayer, so the transaction sender is not the voter. The relayer
///      cannot alter a vote: the zk proof is bound to the ballot handle, and the handle is bound to the sender.
contract AnonymousConfidentialVote is EncryptedTally {
    /// @dev BN254 scalar field modulus: every zk public input must be reduced modulo this.
    uint256 internal constant FIELD_MODULUS =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    IVoteVerifier public immutable verifier;
    /// @notice Merkle root of the voters' identity commitments, fixed when the poll is created.
    uint256 public immutable voterRoot;

    mapping(uint256 nullifier => bool) public nullifierUsed;

    event Voted(uint256 indexed nullifier);

    error NullifierAlreadyUsed();

    constructor(
        string memory proposal_,
        uint256 durationSeconds,
        uint256 voterRoot_,
        IVoteVerifier verifier_
    ) EncryptedTally(proposal_, durationSeconds) {
        voterRoot = voterRoot_;
        verifier = verifier_;
    }

    /// @notice The poll identifier that nullifiers are derived from: the contract address, so the same voter
    ///         gets unrelated nullifiers in different polls.
    function pollId() public view returns (uint256) {
        return uint256(uint160(address(this)));
    }

    /// @notice The zk public input that binds a proof to one encrypted ballot.
    function ballotHash(externalEbool encryptedSupport) public pure returns (uint256) {
        return uint256(externalEbool.unwrap(encryptedSupport)) % FIELD_MODULUS;
    }

    /// @notice Cast an anonymous encrypted ballot: true = yes, false = no.
    /// @param nullifier MiMC(secret, pollId): one per voter per poll, unlinkable to the voter's commitment
    /// @param encryptedSupport the encrypted ballot handle (encrypted for this contract and msg.sender)
    /// @param inputProof FHE input proof binding the ciphertext to this contract and msg.sender
    /// @param zkProof Groth16 proof of voter-list membership, bound to `nullifier` and `encryptedSupport`
    function vote(
        uint256 nullifier,
        externalEbool encryptedSupport,
        bytes calldata inputProof,
        bytes calldata zkProof
    ) external whileOpen {
        if (nullifierUsed[nullifier]) revert NullifierAlreadyUsed();
        nullifierUsed[nullifier] = true;

        // The verifier rejects unreduced inputs, so `nullifier + p` cannot be used to vote twice.
        verifier.verifyProof(zkProof, [voterRoot, nullifier, pollId(), ballotHash(encryptedSupport)]);

        ebool support = FHE.fromExternal(encryptedSupport, inputProof);
        _addBallot(support);

        emit Voted(nullifier);
    }
}
